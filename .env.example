# ==============================================================================
# KODRA MASTER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env and configure your environment-specific credentials.
# Do NOT commit your actual .env file to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER (LAYER 1 & 4)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CLIENT (FRONTEND VITE)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_WS_BASE_URL=ws://localhost:5000
VITE_PREVIEW_DOMAIN=preview.localhost:5000

# ------------------------------------------------------------------------------
# 3. DATABASE (LAYER 3 - MONGODB ATLAS / LOCAL)
# ------------------------------------------------------------------------------
# Example Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kodra_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://kodra_user:your_password@cluster0.mongodb.net/kodra_dev?retryWrites=true&w=majority
MONGODB_AUTO_INDEX=true
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. WORKSPACE STORAGE (LAYER 3 - DISK PERSISTENCE)
# ------------------------------------------------------------------------------
STORAGE_BASE_PATH=./server/workspaces
MAX_PROJECT_STORAGE_MB=500
MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 5. DOCKER SANDBOX (LAYER 4 - INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# On Windows, leave blank to auto-detect named pipe //./pipe/docker_engine
DOCKER_SOCKET_PATH=
DOCKER_BASE_IMAGE=node:20-alpine
DOCKER_CONTAINER_WORKDIR=/workspace
DOCKER_DEFAULT_USER=node
DOCKER_MEMORY_LIMIT_BYTES=1073741824
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=100
DOCKER_NETWORK_NAME=kodra-sandboxes
DOCKER_EXEC_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 6. AI PROVIDER ABSTRACTION (LAYER 4 - INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# Active AI provider: 'gemini' | 'openai' | 'mistral' | 'ollama'
AI_DEFAULT_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-1.5-pro-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

# OpenAI Configuration (Plug & Play ready)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# Ollama / Local Configuration (Plug & Play ready)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# 7. AI AGENT REASONING ENGINE (LAYER 2)
# ------------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=15
AGENT_COMMAND_TIMEOUT_MS=45000
AGENT_TOOL_OUTPUT_MAX_CHARS=8000

# ------------------------------------------------------------------------------
# 8. AUTHENTICATION (FIREBASE - LAYER 4)
# ------------------------------------------------------------------------------
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 9. PREVIEW REVERSE PROXY GATEWAY
# ------------------------------------------------------------------------------
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_PORT_RANGE_START=30000
PREVIEW_PORT_RANGE_END=35000

# ------------------------------------------------------------------------------
# 10. USAGE TRACKING, QUOTAS & STRIPE BILLING (LAYER 4)
# ------------------------------------------------------------------------------
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly

# Tier Quota Thresholds
FREE_TIER_MAX_TOKENS_MONTHLY=50000
FREE_TIER_MAX_SANDBOX_HOURS_MONTHLY=10
FREE_TIER_MAX_PROJECTS=3

PRO_TIER_MAX_TOKENS_MONTHLY=2000000
PRO_TIER_MAX_SANDBOX_HOURS_MONTHLY=200
PRO_TIER_MAX_PROJECTS=50

# ------------------------------------------------------------------------------
# 11. PRODUCTION DEPLOYMENT, S3 CLOUD STORAGE & SECURITY (LAYER 4)
# ------------------------------------------------------------------------------
S3_BACKUP_BUCKET=kodra-workspaces-backup
S3_BACKUP_REGION=us-east-1
S3_BACKUP_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Docker Daemon Security Hardening
ENFORCE_DOCKER_SECURITY_PROFILES=false
DOCKER_DROP_ALL_CAPABILITIES=true
DOCKER_NO_NEW_PRIVILEGES=true
DOCKER_PRODUCTION_PIDS_LIMIT=100


