# ==============================================================================
# KODRA CLOUD PRODUCTION CONFIGURATION (.env.production)
# ==============================================================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=https://kodra.dev,https://app.kodra.dev
LOG_LEVEL=info

# Frontend Client
VITE_API_BASE_URL=https://api.kodra.dev/api/v1
VITE_WS_BASE_URL=wss://api.kodra.dev
VITE_PREVIEW_DOMAIN=preview.kodra.dev

# Database - MongoDB Atlas Production Peering
MONGODB_URI=mongodb+srv://kodra_prod_user:<password>@cluster0.mongodb.net/kodra_production?retryWrites=true&w=majority
MONGODB_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Workspace Storage
STORAGE_BASE_PATH=/app/server/workspaces
MAX_PROJECT_STORAGE_MB=1000
MAX_FILE_SIZE_BYTES=10485760

# Docker Sandbox Infrastructure (Production Socket Proxy)
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_BASE_IMAGE=kodra/sandbox:latest
DOCKER_CONTAINER_WORKDIR=/workspace
DOCKER_DEFAULT_USER=node
DOCKER_MEMORY_LIMIT_BYTES=2147483648
DOCKER_CPU_LIMIT=2.0
DOCKER_PIDS_LIMIT=150
DOCKER_NETWORK_NAME=kodra-sandboxes-prod
DOCKER_EXEC_TIMEOUT_MS=60000

# Docker Daemon Security Hardening
ENFORCE_DOCKER_SECURITY_PROFILES=true
DOCKER_DROP_ALL_CAPABILITIES=true
DOCKER_NO_NEW_PRIVILEGES=true
DOCKER_PRODUCTION_PIDS_LIMIT=150

# S3 Persistent Storage & Cloud Workspaces Backup
S3_BACKUP_BUCKET=kodra-prod-workspaces-backup
S3_BACKUP_REGION=us-east-1
S3_BACKUP_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# AI Provider Abstraction
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Authentication
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=kodra-production
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Wildcard Live Preview Domain (Production SSL *.preview.kodra.dev)
PREVIEW_BASE_DOMAIN=preview.kodra.dev
PREVIEW_PORT_RANGE_START=30000
PREVIEW_PORT_RANGE_END=35000

# Stripe Commercial Monetization
BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_live_monthly
